{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@vanni/provider-sdk": [
        "../../packages/provider-sdk/dist/index.d.ts"
      ],
      "@vanni/providers": [
        "../../packages/providers/dist/index.d.ts"
      ],
      "@vanni/observability": [
        "../../packages/observability/dist/index.d.ts"
      ],
      "@vanni/billing": [
        "../../packages/billing/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
