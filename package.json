{
  "name": "vanni",
  "version": "1.0.0",
  "private": true,
  "description": "VANNI — Autonomous Conversational AI Employee Runtime for Regional Businesses",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "npm run start --prefix apps/server",
    "server:dev": "npm run dev --prefix apps/server",
    "api": "npm run start --prefix apps/api",
    "voice": "npm run start --prefix apps/voice-gateway",
    "web": "npm run build --prefix apps/web",
    "build": "npm run build --prefix packages/shared && npm run build --prefix packages/provider-sdk && npm run build --workspaces --if-present",
    "clean": "tsc --build --clean",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:invariants": "vitest run packages/core/src/__tests__/invariants.test.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "node scripts/typecheck-all.mjs",
    "prepare": "husky install || true",
    "start": "npm run server"
  },
  "keywords": [
    "conversational-ai",
    "kannada-voice-agent",
    "telephony",
    "sarvam-ai",
    "synthetic-intelligence"
  ],
  "author": "Antigravity Sovereign Architecture",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "husky": "^9.0.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
