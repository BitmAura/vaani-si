# =============================================================================
# VANNI — Vercel Environment Variables Reference
# Copy each of these into Vercel Dashboard → Project Settings → Environment Variables
# =============================================================================

# REQUIRED: Server will CRASH without this in production
NODE_ENV=production
COOKIE_SECRET=<run: openssl rand -base64 48>

# REQUIRED: Your Vercel deployment URL (add all domains you use)
ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.com
APP_URL=https://your-project.vercel.app
API_URL=https://your-project.vercel.app
GATEWAY_URL=https://your-voice-gateway.azurecontainerapps.io
WS_GATEWAY_URL=wss://your-voice-gateway.azurecontainerapps.io

# REQUIRED: Supabase (enables persistent auth & database on Vercel stateless env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGci...  # anon key
SUPABASE_SECRET_KEY=eyJhbGci...       # service_role key
FORCE_SUPABASE_DB=true                # Critical: forces Supabase instead of local file

# Sarvam AI — Voice (STT + TTS)
SARVAM_API_KEY=your-sarvam-api-key

# Gemini — Conversation LLM
GEMINI_API_KEY=your-gemini-api-key

# Exotel — Telephony (SIP trunking for inbound/outbound calls)
EXOTEL_ACCOUNT_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_CALLER_ID=+9180XXXXXXXX
EXOTEL_WEBHOOK_SECRET=your-exotel-webhook-secret

# Razorpay — Billing & Subscriptions
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# WhatsApp Business API
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Meta Lead Ads (Speed-to-Lead webhook)
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=vanni_secure_token
META_WEBHOOK_ALLOW_UNSIGNED=false

# Log Level
LOG_LEVEL=info
