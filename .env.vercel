# ==============================================================================
# VANNI SI: VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# Copy these values into Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Core Runtime
NODE_ENV=production
COOKIE_SECRET=vanni_prod_secret_key_93847291837482910394817263547182
ALLOWED_ORIGINS=https://vanni-si.vercel.app,https://your-custom-domain.com

# 1-Click Instant Industry Demo Accounts
# Set to 'true' so the demo buttons on /login (Digital Agency, Real Estate, Healthcare)
# log in instantly without needing manual user registration.
ALLOW_DEMO_ACCOUNTS=true

# Database Persistence (Supabase PostgreSQL)
FORCE_SUPABASE_DB=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# AI Voice & Dialogue Engine
SARVAM_API_KEY=your-sarvam-ai-key
GEMINI_API_KEY=your-gemini-api-key

# App Public URLs
APP_URL=https://vanni-si.vercel.app
API_URL=https://vanni-si.vercel.app

# Real-Time Voice Gateway (Deployed on Azure Container Apps using Student Credits)
VOICE_WS_URL=wss://vanni-voice-gateway.your-azure-domain.azurecontainerapps.io/ws/audio-stream

# Razorpay (Billing)
RAZORPAY_KEY_ID=rzp_test_or_live_key
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Exotel (Telephony & SIP Trunking)
EXOTEL_ACCOUNT_SID=your-exotel-sid
EXOTEL_API_KEY=your-exotel-key
EXOTEL_API_TOKEN=your-exotel-token
EXOTEL_WEBHOOK_SECRET=your-exotel-webhook-secret

# WhatsApp Cloud API & Meta Lead Ads
WHATSAPP_API_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=vanni_secure_token
