# ==============================================================================
# VANNI — Conversational Voice Intelligence OS
# Production Environment Template (Never commit actual secrets to Git)
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=development
API_PORT=4100
VOICE_PORT=4200
HOST=0.0.0.0
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4100,http://localhost:4200,https://vanni.ai

# Database & Supabase Multi-Tenancy
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Regional Speech & Indian Voice Infrastructure (Sarvam AI Saaras STT & Bulbul v2 TTS)
# https://www.sarvam.ai/
SARVAM_API_KEY=sarvam_live_placeholder

# Conversational LLM Engine (Gemini 1.5 Flash / Groq / OpenAI)
GEMINI_API_KEY=gemini_live_placeholder

# Telephony Gateway (Exotel / Twilio PSTN Cellular Trunking)
EXOTEL_ACCOUNT_SID=exotel_sid_placeholder
EXOTEL_API_KEY=exotel_key_placeholder
EXOTEL_API_TOKEN=exotel_token_placeholder
EXOTEL_CALLER_ID=+9180XXXXXXXX
VOICE_WS_URL=ws://localhost:4200/ws/voice-stream

# Razorpay Subscriptions & Recurring Mandates (Module 19)
# Client bundle receives ONLY public key ID
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
# Server-only secrets:
RAZORPAY_KEY_SECRET=rzp_sec_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# WhatsApp Business API Lead Dispatch (Interakt / Gupshup / Cloud API)
WHATSAPP_API_TOKEN=whatsapp_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=phone_id_placeholder

# Application URLs
APP_URL=http://localhost:3000

# Meta Lead Ads Webhook (Speed-to-Lead)
# META_APP_SECRET is REQUIRED: the webhook verifies x-hub-signature-256 and fails
# closed (503) when it is missing, to prevent unauthenticated call dispatch.
META_APP_SECRET=meta_app_secret_placeholder
META_VERIFY_TOKEN=vanni_secure_token
# Local-only escape hatch for testing unsigned webhooks. NEVER enable in production.
META_WEBHOOK_ALLOW_UNSIGNED=false
