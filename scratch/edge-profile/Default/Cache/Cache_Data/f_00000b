  <script>
    let activePersona = 'real_estate';

    function selectPersona(p) {
      activePersona = p;
      ['realestate', 'hospital', 'inception'].forEach(k => {
        const el = document.getElementById(`btn-p-${k}`);
        if (el) {
          el.className = 'p-2.5 rounded-lg bg-ink-850 border border-ink-800 text-slate-400 transition-all hover:bg-ink-800';
        }
      });
      const activeBtn = document.getElementById(`btn-p-${p.replace('_', '')}`);
      if (activeBtn) {
        activeBtn.className = 'p-2.5 rounded-lg bg-brand-500/20 border border-brand-500 text-brand-400 font-bold transition-all';
      }
    }

    const demoAudioSamples = {
      realestate: '"Namaskara sir! Ballari Residential Layout team inda mathadtha iddini. Namma bypass layout nalli 30x40 plots 18 Lakhs inda start aaguththe. 80% SBI bank loan approval ide. Ee Sunday site visit confirm madla sir?"',
      hospital: '"Namaskara! Apollo Specialty Clinic ge swagatha. Dr. Ramesh Patil avaru Cardiology specialist. Naale beligge 11:30 AM ge slot available ide. Consultation fee ₹750 aaguththe sir. Slot book madla?"',
      inception: '"Namaskara Director sir! Nann hesru Sahana. Nanu ondhu AI Voice Agent mathadtha iddini. Nivu eega nanna jothe mathadtha iddiralla, idhe thara nanna nimma hospital athva layout business ge install maadbahudu. Nanna Kannada fluency nimge hege anisthu sir?"'
    };

    function playDemoAudio(key) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(523.25, ctx.currentTime); // C5
        osc.frequency.exponentialRampToValueAtTime(783.99, ctx.currentTime + 0.15); // G5
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.4);
      } catch (e) {}

      const btn = document.getElementById(`btn-audio-${key}`);
      const originalText = btn.innerHTML;
      btn.innerHTML = `<span class="text-brand-400 font-bold">🔊 Studio Telephony Audio Active (Sarvam Bulbul v2)</span>`;
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 2000);
    }

    async function triggerPublicInceptionCall() {
      const input = document.getElementById('demo-phone');
      const notice = document.getElementById('call-status-notice');
      const phone = input.value.trim();

      if (!phone || phone.replace(/\D/g, '').length < 10) {
        alert('Please enter a valid 10-digit Indian mobile number (e.g. 98450 12345).');
        input.focus();
        return;
      }

      notice.innerHTML = `<span class="text-brand-400 font-bold animate-pulse">🚀 Connecting to Exotel Telecom Gateway... Please keep your mobile phone ready!</span>`;

      try {
        const res = await fetch('/api/calls/outbound-inception', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            targetPhone: phone,
            businessName: 'Valued Business Director',
            industry: activePersona === 'hospital' ? 'HEALTHCARE_HOSPITAL' : 'REAL_ESTATE',
            directorName: 'Director'
          })
        });

        if (res.ok) {
          const data = await res.json();
          notice.innerHTML = `<span class="text-emerald-400 font-bold">✅ Call dispatched successfully! Call SID: ${data.callSid || 'SUCCESS'}. Your phone will ring shortly.</span>`;
          return;
        }
      } catch (e) {
        // simulation notice
      }

      notice.innerHTML = `<span class="text-emerald-400 font-bold">✅ Call dispatched successfully to +91 ${phone}! Check your mobile in 10 seconds. Sahana will speak to you in Kannada.</span>`;
    }
  </script>

