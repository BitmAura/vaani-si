                </svg>
              </div>
              <div class="truncate">
                <div class="font-bold text-white text-xs">Ballari Residential Layouts</div>
                <div class="text-[10px] text-slate-400">Real Estate • 30x40 Plots</div>
              </div>
            </button>
            <button onclick="switchTenant('hospital')" class="w-full p-2.5 rounded-lg hover:bg-onyx-800 text-left transition-colors flex items-center space-x-2.5">
              <div class="w-6 h-6 rounded-md bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <div class="truncate">
                <div class="font-bold text-white text-xs">Apollo Specialty Clinic</div>
                <div class="text-[10px] text-slate-400">Cardiology & Ortho OPD</div>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- Functional Navigation Links -->
      <nav class="p-2 space-y-1 text-xs font-medium">
        <button onclick="switchTab('calls')" id="nav-tab-calls" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg bg-brand-500/10 text-brand-400 font-semibold border border-brand-500/20 text-left transition-all">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="truncate">All Call Logs</span>
          <span class="ml-auto px-1.5 py-0.5 rounded bg-brand-500/20 text-brand-400 text-[10px] font-mono font-bold">1,248</span>
        </button>

        <button onclick="switchTab('leads')" id="nav-tab-leads" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-onyx-850 text-left transition-all">
          <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="truncate">Hot Leads & Pipeline</span>
          <span class="ml-auto px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 text-[10px] font-mono font-bold">384</span>
        </button>

        <button onclick="switchTab('agent')" id="nav-tab-agent" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-onyx-850 text-left transition-all">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
