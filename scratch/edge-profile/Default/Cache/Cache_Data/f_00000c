            ಧ
          </div>
          <div>
            <div class="flex items-center space-x-1.5">
              <span class="font-extrabold text-sm tracking-tight text-white">DHWANI<span class="text-brand-400 font-mono text-[10px] ml-1 font-bold px-1 py-0.5 rounded bg-brand-500/10 border border-brand-500/20">SI</span></span>
            </div>
            <div class="text-[10px] text-slate-400 font-medium">Enterprise Telephony OS</div>
