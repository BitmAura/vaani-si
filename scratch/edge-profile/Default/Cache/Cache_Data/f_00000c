          <div id="stat-wa-delivered" class="mt-1.5 text-xl font-extrabold text-white font-mono tnum">12 Sent</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Instant Owner Alert Pushed</div>
        </div>

        <div class="p-3.5 rounded-xl card-craft">
          <div class="flex items-center justify-between text-[11px] text-slate-400">
            <span class="font-medium">Turnaround Latency</span>
            <span class="px-1.5 py-0.5 rounded bg-brand-500/10 text-brand-400 border border-brand-500/20 text-[9px] font-bold">&lt; 750ms SLA</span>
          </div>
          <div id="stat-latency" class="mt-1.5 text-xl font-extrabold text-brand-400 font-mono tnum">382ms</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Sarvam Bulbul v2 + Saaras</div>
        </div>
      </div>

      <!-- Filters & Instant Search Strip -->
      <div class="px-6 py-2.5 flex items-center justify-between border-b border-white/[0.07] bg-onyx-900 shrink-0 text-xs">
        <div class="flex items-center space-x-1.5">
          <button onclick="setFilter('ALL')" id="flt-all" class="px-2.5 py-1 rounded-lg bg-onyx-800 text-white font-semibold border border-white/[0.1] text-xs">
            All Calls (1,248)
          </button>
          <button onclick="setFilter('HOT')" id="flt-hot" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white hover:bg-onyx-850 transition-colors text-xs flex items-center space-x-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Hot Leads (384)</span>
          </button>
          <button onclick="setFilter('VISIT')" id="flt-visit" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white hover:bg-onyx-850 transition-colors text-xs flex items-center space-x-1">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>Site Visits Booked (192)</span>
          </button>
        </div>

        <!-- Linear-Style Command Search Input -->
        <div class="relative w-80">
          <svg class="w-3.5 h-3.5 text-slate-500 absolute left-3 top-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" id="live-search" name="search" title="Filter by name, phone, plot, or city" aria-label="Filter by name, phone, plot, or city" oninput="filterTableRealTime(this.value)" placeholder="Filter by name, phone, plot, or city..." class="w-full pl-9 pr-14 py-1.5 rounded-lg bg-onyx-850 border border-white/[0.08] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-500/50 transition-all font-mono">
          <div class="absolute right-2 top-2 px-1.5 py-0.5 rounded bg-white/[0.06] border border-white/[0.08] text-[9px] font-mono text-slate-400 select-none">
            ⌘K
          </div>
        </div>
      </div>

      <!-- Main CRM Table Viewport -->
      <div class="flex-1 overflow-y-auto custom-scroll px-6 py-4">
        <div class="rounded-xl border border-white/[0.08] bg-onyx-900 overflow-hidden shadow-xl">
          <table class="w-full text-left border-collapse text-xs">
            <thead class="bg-onyx-850 border-b border-white/[0.08] text-slate-400 text-[11px] font-semibold select-none">
              <tr>
                <th class="py-2.5 px-4 font-mono text-[10px] uppercase tracking-wider text-slate-400">Caller & City</th>
                <th class="py-2.5 px-4 font-mono text-[10px] uppercase tracking-wider text-slate-400">Channel & Time</th>
                <th class="py-2.5 px-3 font-mono text-[10px] uppercase tracking-wider text-slate-400">Lead Status</th>
                <th class="py-2.5 px-4 font-mono text-[10px] uppercase tracking-wider text-slate-400">Requirement & Budget</th>
                <th class="py-2.5 px-4 font-mono text-[10px] uppercase tracking-wider text-slate-400">Confirmed Outcome</th>
                <th class="py-2.5 px-3 text-center font-mono text-[10px] uppercase tracking-wider text-slate-400">Audio</th>
                <th class="py-2.5 px-3 text-right font-mono text-[10px] uppercase tracking-wider text-slate-400">Inspect</th>
              </tr>
            </thead>
            <tbody id="calls-table-body" class="divide-y divide-white/[0.05] text-slate-300">
              <!-- Dynamically hydrated from API -->
            </tbody>
          </table>
        </div>
        
        <!-- Keyboard shortcuts helper footer -->
