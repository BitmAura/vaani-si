        </button>

        <button onclick="switchTab('whatsapp')" id="nav-tab-whatsapp" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-onyx-850 text-left transition-all">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span class="truncate">WhatsApp Dispatches</span>
          <span class="ml-auto px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-bold">100%</span>
        </button>

        <button onclick="switchTab('speed-to-lead')" id="nav-tab-speed-to-lead" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-onyx-850 text-left transition-all">
          <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="truncate">Speed-to-Lead Webhook</span>
        </button>

        <button onclick="switchTab('crm-stack')" id="nav-tab-crm-stack" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-onyx-850 text-left transition-all">
          <svg class="w-4 h-4 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span class="truncate">Open-Source Stack (Twenty/Qwen)</span>
          <span class="ml-auto w-1.5 h-1.5 rounded-full bg-purple-400"></span>
        </button>
      </nav>
    </div>

    <!-- User Profile & Sign Out Footer -->
    <div class="p-3 border-t border-white/[0.07]">
      <div class="p-2.5 rounded-xl bg-onyx-850 border border-white/[0.06] flex items-center justify-between">
        <div class="flex items-center space-x-2.5 truncate">
          <div class="w-7 h-7 rounded-lg bg-brand-500/15 text-brand-400 border border-brand-500/20 flex items-center justify-center font-bold text-xs shrink-0 font-mono">
            AD
          </div>
          <div class="truncate">
            <div id="user-name" class="font-bold text-xs text-white truncate">Ballari Layouts Admin</div>
            <div class="text-[10px] text-slate-400 truncate">Sovereign Tenant</div>
          </div>
        </div>
        <a href="/login" title="Sign Out" class="text-slate-400 hover:text-white p-1 rounded hover:bg-onyx-800 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </a>
      </div>
    </div>

  </aside>

  <!-- ========================================================================= -->
  <!-- 2. MAIN APPLICATION CONTENT VIEWPORT -->
  <!-- ========================================================================= -->
  <main class="flex-1 flex flex-col h-screen overflow-hidden bg-onyx-950">
    
    <!-- Top Executive App Bar -->
    <header class="h-14 bg-onyx-900 border-b border-white/[0.07] px-6 flex items-center justify-between shrink-0 z-10">
      
      <div class="flex items-center space-x-4">
        <div>
          <h1 id="page-title" class="text-sm font-bold text-white tracking-tight flex items-center space-x-2">
            <span>Call Operations & CRM</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">PSTN Live</span>
          </h1>
          <p id="page-sub" class="text-[11px] text-slate-400">Live bilingual recordings, transcripts, and verified lead dossiers</p>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="flex items-center space-x-2.5">
        <!-- Live Edge Telemetry -->
        <div class="hidden lg:flex items-center space-x-2 px-3 py-1 rounded-full bg-onyx-850 border border-white/[0.08] text-[11px] font-mono text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Pune Edge (18ms)</span>
          <span class="text-slate-600">•</span>
          <span>MOS: <span class="text-emerald-400 font-bold">4.42</span></span>
        </div>

        <button onclick="openInceptionModal()" class="px-3 py-1.5 rounded-lg bg-onyx-850 hover:bg-onyx-800 border border-white/[0.08] text-xs font-semibold text-slate-200 transition-all flex items-center space-x-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Outbound Inception</span>
        </button>

        <button onclick="toggleVoiceModal()" class="px-3.5 py-1.5 rounded-lg bg-brand-500 hover:bg-brand-400 text-black font-extrabold text-xs shadow-md shadow-brand-500/20 transition-all flex items-center space-x-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
          </svg>
          <span>Test Sahana (Mic)</span>
        </button>
      </div>

    </header>

    <!-- ======================================================================= -->
    <!-- VIEW 1: ALL CALL LOGS (ACTIVE DEFAULT) -->
    <!-- ======================================================================= -->
    <div id="view-calls" class="flex-1 flex flex-col overflow-hidden">
      
      <!-- 4 KPI Cards -->
      <div class="px-6 py-3.5 grid grid-cols-2 lg:grid-cols-4 gap-3.5 border-b border-white/[0.07] bg-onyx-900/60 shrink-0">
        <div class="p-3.5 rounded-xl card-craft">
          <div class="flex items-center justify-between text-[11px] text-slate-400">
            <span class="font-medium">Today's Inbound Calls</span>
            <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[9px] font-bold">100% Picked Up</span>
          </div>
          <div id="stat-total-calls" class="mt-1.5 text-xl font-extrabold text-white font-mono tnum">12 Calls</div>
          <div class="text-[10px] text-slate-400 mt-0.5">0 Missed • 0 Drop-offs</div>
        </div>

        <div class="p-3.5 rounded-xl card-craft">
          <div class="flex items-center justify-between text-[11px] text-slate-400">
            <span class="font-medium">Hot Qualified Leads</span>
            <span class="px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[9px] font-bold">75.0% Conversion</span>
          </div>
          <div id="stat-hot-leads" class="mt-1.5 text-xl font-extrabold text-amber-400 font-mono tnum">9 Leads</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Sunday Site Visit Confirmed</div>
        </div>

        <div class="p-3.5 rounded-xl card-craft">
          <div class="flex items-center justify-between text-[11px] text-slate-400">
            <span class="font-medium">WhatsApp Dispatches</span>
            <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[9px] font-bold">&lt; 3s Delivery</span>
