        if (filterText) {
          const q = filterText.toLowerCase();
          const caller = (item.caller || '').toLowerCase();
          const phone = String(item.phone || '');
          const city = (item.city || '').toLowerCase();
          const req = (item.req || item.intent || '').toLowerCase();
